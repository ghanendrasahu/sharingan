# General
APP_NAME=LegalLens India
APP_VERSION=0.1.0
DEBUG=true

# Security
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://legallens:legallens@localhost:5432/legallens
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO for local dev)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=legallens-documents
OBJECT_STORAGE_REGION=us-east-1

# LLM Provider
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o

# Groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant  # Free tier: 30 RPM, 500K TPD, 30K TPM

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=text-embedding-3-small

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Upload limits
MAX_UPLOAD_SIZE_MB=50
